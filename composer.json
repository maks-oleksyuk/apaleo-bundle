{
    "name": "oleksyuk/apaleo-bundle",
    "description": "Symfony bundle for integrating the Apaleo hotel PMS API SDK",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "apaleo",
        "symfony",
        "symfony-bundle",
        "hotel",
        "pms",
        "api-client",
        "sdk"
    ],
    "authors": [
        {
            "name": "Maks Oleksyuk",
            "email": "maksym.oleksyuk@gmail.com",
            "homepage": "https://github.com/maks-oleksyuk"
        }
    ],
    "homepage": "https://github.com/maks-oleksyuk/apaleo-bundle",
    "support": {
        "issues": "https://github.com/maks-oleksyuk/apaleo-bundle/issues",
        "source": "https://github.com/maks-oleksyuk/apaleo-bundle"
    },
    "require": {
        "php": "^8.4",
        "nyholm/psr7": "^1.8.2",
        "oleksyuk/apaleo-php": "dev-main",
        "php-http/discovery": "^1.20",
        "symfony/cache": "^8.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/http-kernel": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.26",
        "phpstan/phpstan": "^2.2.14",
        "phpunit/phpunit": "^13.3.4",
        "rector/rector": "^2.6.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Oleksyuk\\Apaleo\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oleksyuk\\Apaleo\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
