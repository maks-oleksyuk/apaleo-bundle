{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.callcount > 0 %}
        {% set icon %}
            {{ source('@Apaleo/Icon/apaleo.svg') }}
            <span class="sf-toolbar-value">{{ collector.callcount }}</span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Requests</b>
                <span>{{ collector.callcount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Total time</b>
                <span>{{ '%.1f'|format(collector.totaldurationms) }} ms</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.callcount == 0 ? 'disabled' }}">
        <span class="icon" aria-hidden="true">
            {{ source('@Apaleo/Icon/apaleo.svg') }}
        </span>
        <strong>Apaleo</strong>
        {% if collector.callcount > 0 %}
            <span class="count">
                <span>{{ collector.callcount }}</span>
            </span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>Apaleo SDK requests</h2>

    {% if collector.callcount == 0 %}
        <div class="empty">
            <p>No Apaleo API calls were made during this request.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric-group">
                <div class="metric">
                    <span class="value">{{ collector.callcount }}</span>
                    <span class="label">Requests</span>
                </div>
                <div class="metric">
                    <span class="value">{{ '%.1f'|format(collector.totaldurationms) }} <span class="unit">ms</span></span>
                    <span class="label">Total time</span>
                </div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Method</th>
                    <th>URI</th>
                    <th>Status</th>
                    <th>Duration</th>
                </tr>
            </thead>
            <tbody>
                {% for trace in collector.traces %}
                    <tr>
                        <td>{{ trace.method }}</td>
                        <td>{{ trace.uri }}</td>
                        <td>
                            {% if trace.error %}
                                <span class="label status-error">error</span>
                            {% elseif trace.statusCode >= 400 %}
                                <span class="label status-error">{{ trace.statusCode }}</span>
                            {% else %}
                                <span class="label status-success">{{ trace.statusCode }}</span>
                            {% endif %}
                        </td>
                        <td>{{ '%.1f'|format(trace.durationMs) }} ms</td>
                    </tr>
                    {% if trace.error %}
                        <tr>
                            <td colspan="4"><code>{{ trace.error }}</code></td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
